/*
 * Shared keymap: 41 keys (left outer bottom omitted).
 * Source of truth: /home/httpkiwi/Projects/Kiwiboard/layout.vil
 * (Vial app export of Custom Split). Number row folded away — Corne has none.
 *
 * Layers: 0 base, 1 lower, 2 raise, 3 adjust (tri-layer), 4 gaming
 *
 * Dongle bootloader: combo Tab + Bspc → &bootloader (ZMK-only; not in Vial).
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/mouse.h>

/ {
        combos {
                compatible = "zmk,combos";
                /* Vial: Q+W → Esc */
                combo_qw_esc {
                        timeout-ms = <50>;
                        key-positions = <1 2>;
                        bindings = <&kp ESC>;
                };
                /* Vial: J+K → Esc */
                combo_jk_esc {
                        timeout-ms = <50>;
                        key-positions = <19 20>;
                        bindings = <&kp ESC>;
                };
                /* Vial: L+; → : */
                combo_l_semi_colon {
                        timeout-ms = <50>;
                        key-positions = <21 22>;
                        bindings = <&kp COLON>;
                };
                /* Tab + Backspace → UF2 on the dongle (combo = central) */
                combo_bootloader {
                        timeout-ms = <80>;
                        key-positions = <0 11>;
                        bindings = <&bootloader>;
                };
        };

        conditional_layers {
                compatible = "zmk,conditional-layers";
                tri_layer {
                        if-layers = <1 2>;
                        then-layer = <3>;
                };
        };

        keymap {
                compatible = "zmk,keymap";

                default_layer {
/* layout.vil layer 0 (alphas + thumbs; num row omitted) */
// -----------------------------------------------------------------------------------------
// |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BSPC |
// | LSFT |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
// |      |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | RSFT |
//                    | CTL | LWR | ENT |   | SPC | RSE  | ALT |
                        bindings = <
   &kp TAB     &kp Q         &kp W         &kp E        &kp R       &kp T    &kp Y        &kp U         &kp I         &kp O        &kp P            &kp BSPC
   &kp LSHIFT  &mt LSHIFT A  &mt LCTRL S   &mt LGUI D   &mt LALT F  &kp G    &kp H        &mt RALT J    &mt RGUI K    &mt RCTRL L  &mt RSHIFT SEMI  &kp SQT
               &kp Z         &kp X         &kp C        &kp V       &kp B    &kp N        &kp M         &kp COMMA     &kp DOT      &kp FSLH         &kp RSHIFT
                                       &kp LCTRL &mo 1 &mt LGUI RET          &mt LSHIFT SPACE &mo 2 &kp RALT
                        >;
                };

                lower_layer {
/* layout.vil layer 1 — symbols left, numpad right (F-keys were on num row). */
// -----------------------------------------------------------------------------------------
// |  `   |  ^  |  &  |  *  |  (  |  )  |   |  [  |  1  |  2  |  3  |  ~  | DEL  |
// | ESC  |  !  |  @  |  #  |  $  |  %  |   |  _  |  4  |  5  |  6  |  "  |  |   |
// |      |  =  |  -  |  +  |  {  |  }  |   |  ]  |  7  |  8  |  9  |  \  |      |
//                    | GUI |     |     |   |     |     |  0  |
                        bindings = <
   &kp GRAVE  &kp CARET &kp AMPS  &kp ASTRK &kp LPAR  &kp RPAR   &kp LBKT  &kp N1    &kp N2    &kp N3    &kp TILDE &kp DEL
   &kp ESC    &kp EXCL  &kp AT    &kp HASH  &kp DLLR  &kp PRCNT  &kp UNDER &kp N4    &kp N5    &kp N6    &kp DQT   &kp PIPE
              &kp EQUAL &kp MINUS &kp PLUS  &kp LBRC  &kp RBRC   &kp RBKT  &kp N7    &kp N8    &kp N9    &kp BSLH  &trans
                                    &kp LGUI &trans &trans         &trans &mo 2 &kp N0
                        >;
                };

                raise_layer {
/* layout.vil layer 2 — inverted-T arrows (I=↑ J=← K=↓ L=→). */
// -----------------------------------------------------------------------------------------
// |      | INS | PSCR| MENU|     |     |   | PGUP| HOME|  ↑  | END |     | BSPC |
// |      | LALT| LCTL| LSFT|     | CAPS|   | PGDN|  ←  |  ↓  |  →  | DEL | BSPC |
// |      | UNDO| CUT | COPY| PSTE|     |   |     |     |     |     |     |      |
//                    | GUI |     |     |   |     |     | GUI |
                        bindings = <
   &trans   &kp INS   &kp PSCRN  &kp K_APP  &none     &none      &kp PG_UP  &kp HOME   &kp UP    &kp END    &none     &kp BSPC
   &trans   &kp LALT  &kp LCTRL  &kp LSHIFT &none     &kp CAPS   &kp PG_DN  &kp LEFT   &kp DOWN  &kp RIGHT  &kp DEL   &kp BSPC
            &kp LC(Z) &kp LC(X)  &kp LC(C)  &kp LC(V) &none      &none      &none      &none     &none      &none     &trans
                                    &kp LGUI &mo 2 &trans         &trans &trans &kp RGUI
                        >;
                };

                adjust_layer {
/* layout.vil layer 3 — mouse + media. Left empties hold BT (ZMK-only). */
// -----------------------------------------------------------------------------------------
// | BOOT |     |     |     |     |     |   |     | BTN1| BTN2| BTN3|     |      |
// | BTCLR| BT0 | BT1 | BT2 | BT3 | TOG |   |  M← |  M↓ |  M↑ |  M→ |     |      |
// |      |     |     |     |     |     |   |     | PREV| PLAY| NEXT|     |      |
                        bindings = <
   &bootloader &none        &none        &none        &none        &none     &none &mkp LCLK     &mkp RCLK     &mkp MCLK        &none &none
   &bt BT_CLR  &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &to 4     &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_UP &mmv MOVE_RIGHT &none &none
               &none        &none        &none        &none        &none     &none &kp C_PREV    &kp C_PP      &kp C_NEXT  &none &none
                                    &trans &trans &trans         &trans &trans &trans
                        >;
                };

                gaming_layer {
/* layout.vil layer 4 — shifted WASD block; thumb TO(0) exits. */
// -----------------------------------------------------------------------------------------
// |  T   | TAB |  Q  |  W  |  E  |  R  |   |  Y  |  U  |  I  |  O  |  P  | BSPC |
// |  G   | LSFT|  A  |  S  |  D  |  G  |   |  H  |  J  |  K  |  L  |  ;  |  '   |
// |      | CTL |  Z  |  X  |  C  |  V  |   |  N  |  M  |  ,  |  .  |  /  | RSFT |
//                    | CTL | SPC | SFT |   | BASE| RSE | ALT |
                        bindings = <
   &kp T      &kp TAB    &kp Q &kp W &kp E &kp R    &kp Y &kp U &kp I &kp O &kp P &kp BSPC
   &kp G      &kp LSHIFT &kp A &kp S &kp D &kp G    &kp H &kp J &kp K &kp L &kp SEMI &kp SQT
              &kp LCTRL  &kp Z &kp X &kp C &kp V    &kp N &kp M &kp COMMA &kp DOT &kp FSLH &kp RSHIFT
                           &kp LCTRL &kp SPACE &kp LSHIFT    &to 0 &mo 2 &kp RALT
                        >;
                };
        };
};

/ {
        chosen {
                zmk,physical-layout = &kiwiboard_layout;
        };
};

/* layout.vil settings["4"] = 175ms tapping term. Balanced ≈ QMK PERMISSIVE_HOLD. */
&mt {
        tapping-term-ms = <175>;
        flavor = "balanced";
        quick-tap-ms = <175>;
};
