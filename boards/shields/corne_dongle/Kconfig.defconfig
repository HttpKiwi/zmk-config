if SHIELD_CORNE_DONGLE

config ZMK_KEYBOARD_NAME
    default "Kiwiboard"

config ZMK_SPLIT_ROLE_CENTRAL
    default y

config ZMK_SPLIT
    default y

# Left and right halves.
config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
    default 2

# Peripherals plus the 5 Bluetooth profiles.
config BT_MAX_CONN
    default 7

config BT_MAX_PAIRED
    default 7

endif
